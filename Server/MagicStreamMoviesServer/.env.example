# Copy to .env and fill in real values: cp .env.example .env
# .env is listed in .gitignore. Never commit it.

# ---- required ----
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=magic-stream-movies
# Two different random secrets, at least 32 bytes each. Generate with: openssl rand -base64 32
SECRET_KEY=
SECRET_REFRESH_KEY=
OPENAI_API_KEY=
# Must contain the {rankings} placeholder; the review is appended to the end of the prompt.
BASE_PROMPT_TEMPLATE="Return a response using one of these words: {rankings}. The response should be a single word and should not contain any other text. The response should be based on the following review:"

# ---- optional (defaults in parentheses) ----
# PORT=8080
# OPENAI_MODEL=gpt-4.1-mini
# Comma-separated frontend origins (http://localhost:5173)
# ALLOWED_ORIGINS=http://localhost:5173
# RECOMMENDED_MOVIE_LIMIT=5
# Timeouts for normal requests and for OpenAI calls (10s / 30s)
# REQUEST_TIMEOUT=10s
# OPENAI_TIMEOUT=30s
# Refresh token cookie (true / Lax). Use None when frontend and API are on different sites (requires COOKIE_SECURE=true).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax
# Behind a reverse proxy, list its IPs or CIDRs; otherwise rate limiting sees the proxy's IP (default: trust no proxy).
# TRUSTED_PROXIES=10.0.0.0/8
